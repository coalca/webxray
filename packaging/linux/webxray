#!/bin/sh
set -eu

export NODE_ENV="${NODE_ENV:-production}"
export WEBXRAY_DISTRIBUTION="${WEBXRAY_DISTRIBUTION:-deb}"
export WEBXRAY_HOST="${WEBXRAY_HOST:-0.0.0.0}"
export WEBXRAY_DATA_DIR="${WEBXRAY_DATA_DIR:-/var/lib/webxray}"
export WEBXRAY_FRONTEND_DIR="${WEBXRAY_FRONTEND_DIR:-/usr/share/webxray/frontend}"
export WEBXRAY_BUNDLED_XRAY_DIR="${WEBXRAY_BUNDLED_XRAY_DIR:-/usr/lib/webxray/defaults/xray}"
node="/usr/lib/webxray/runtime/node"

run_as_webxray() {
  if [ "$(id -u)" -eq 0 ] && id webxray >/dev/null 2>&1; then
    exec runuser -u webxray -- "$@"
  fi
  exec "$@"
}

if [ "${1:-}" = "-s" ]; then
  action="${2:-}"
  case "$action" in
    install) exec systemctl enable --now webxray.service ;;
    uninstall) exec systemctl disable --now webxray.service ;;
    start|stop|restart|status) exec systemctl "$action" webxray.service ;;
    logs) exec journalctl -u webxray.service -n 100 --no-pager ;;
    *) printf 'Usage: sudo webxray -s install|uninstall|start|stop|restart|status|logs\n' >&2; exit 2 ;;
  esac
fi

if [ "${1:-}" = "token" ]; then
  run_as_webxray "$node" /usr/lib/webxray/server/launcher.mjs --print-token
fi

if [ "${1:-}" = "url" ]; then
  run_as_webxray "$node" /usr/lib/webxray/server/launcher.mjs --print-url
fi

if [ "${1:-}" = "doctor" ]; then
  run_as_webxray "$node" /usr/lib/webxray/server/launcher.mjs --doctor
fi

exec "$node" /usr/lib/webxray/server/launcher.mjs "$@"
